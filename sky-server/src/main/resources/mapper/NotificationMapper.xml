<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.study.mapper.NotificationMapper">

    <select id="pageQueryByUserId" resultType="com.sky.study.vo.NotificationVO">
        select
        id,
        title,
        content,
        read_status,
        create_time
        from notification
        <where>
            user_id = #{userId}
            <if test="readStatus != null">
                and read_status = #{readStatus}
            </if>
        </where>
        order by create_time desc
    </select>
</mapper>
